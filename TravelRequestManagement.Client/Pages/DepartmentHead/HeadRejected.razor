@page "/department-head/rejected"
@layout TravelRequestManagement.Client.Layout.TravelLayout
@rendermode InteractiveAuto
@attribute [Authorize]
@using TravelManagement.Services.Shared.DTOs
@using TravelManagement.Services.Shared.Enums
@inject ITravelApi Api
@inject AuthState Auth

<PageTitle>Rejected - Department Head Dashboard</PageTitle>

@if (Auth.Me is null)
{
    <p>Loading...</p>
}
else if (!Auth.Me.HeadsDepartments)
{
    <section><p>You are not currently assigned as Department Head of any department.</p></section>
}
else
{
    <AreaTabs Tabs="HeadTabs.Items" />

    <section>
        <h2>Rejected</h2>
        <p class="page-subtitle">
            Every request rejected in your department(s) - including ones rejected before you became department head.
            The <strong>Rejected By</strong> column shows whether it was you or a previous department head.
        </p>
        <p class="message">@message</p>
        <RequestTable Items="items" ShowViewLink="true" ViewerRole="depthead"
                      DecisionAction="AuditActionType.DepartmentHeadRejected" CurrentUserId="Auth.Me.Id" DecisionVerb="Rejected" DecisionColumnHeader="Rejected By" />
    </section>
}

@code {
    private string message = "";
    private IReadOnlyList<TravelRequestDto> items = [];

    protected override async Task OnInitializedAsync()
    {
        if (!await Auth.EnsureLoadedAsync()) return;
        await Run(async () => items = await Api.HeadHistoryAsync(false));
    }

    private async Task Run(Func<Task> action)
    {
        try { message = ""; await action(); }
        catch (Exception ex) { message = ApiErrors.Describe(ex); }
    }
}
