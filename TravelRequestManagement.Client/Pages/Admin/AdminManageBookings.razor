@page "/admin/approved-travel/{Id:int}/bookings"
@layout TravelRequestManagement.Client.Layout.TravelLayout
@rendermode InteractiveAuto
@attribute [Authorize]
@using TravelManagement.Services.Shared.Constants
@using TravelManagement.Services.Shared.DTOs
@using TravelManagement.Services.Shared.Enums
@inject ITravelApi Api
@inject AuthState Auth
@inject NavigationManager Nav

<PageTitle>Manage Bookings - Travel Admin</PageTitle>

@if (Auth.Me is null)
{
    <p>Loading...</p>
}
else if (!Auth.Me.Roles.Contains(RoleNames.TravelAdmin))
{
    <section><p>You do not have Travel Admin access.</p></section>
}
else
{
    <AreaTabs Tabs="AdminTabs.Items" />

    <section>
        <div class="section-title">
            <div>
                <h2>Manage bookings</h2>
                <p class="page-subtitle">Add flight, hotel and other bookings for this trip and track each one through to confirmation.</p>
            </div>
            <button @onclick="GoBack">&larr; Back</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(message)) { <p class="message">@message</p> }

        @if (request is null)
        {
            <p class="empty">@(loaded ? "Request was not found." : "Loading...")</p>
        }
        else
        {
            <div class="history-result">
                <div>
                    <p class="request-number">TR-@request.Id.ToString("D6")</p>
                    <h3>@request.Destination</h3>
                    <p class="muted">@request.EmployeeName · @request.DepartmentName · @request.StartDate.ToString("dd MMM yyyy") – @request.EndDate.ToString("dd MMM yyyy") · @request.EstimatedCost</p>
                </div>
                <span class="status status-approved">@request.Status</span>
            </div>

            <h3>Bookings for this trip</h3>
            @if (existingBookings.Count == 0)
            {
                <p class="empty">No bookings recorded yet. Add one below.</p>
            }
            else
            {
                <table>
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Provider</th>
                            <th>Reference</th>
                            <th>Actual cost</th>
                            <th>Status</th>
                            <th>Booked by</th>
                            <th>Update status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in existingBookings)
                        {
                            <tr>
                                <td>@b.Type</td>
                                <td>@b.Provider</td>
                                <td>@b.BookingReference</td>
                                <td>@b.ActualCost</td>
                                <td><span class="status @BookingStatusClass(b.Status)">@b.Status</span></td>
                                <td>@b.BookedByName</td>
                                <td class="status-action">
                                    @{ var options = NextStatusOptions(b.Status); }
                                    @if (options.Count == 0)
                                    {
                                        <span class="muted">Final</span>
                                    }
                                    else
                                    {
                                        <select @bind="pendingStatus[b.Id]">
                                            @foreach (var opt in options)
                                            {
                                                <option value="@opt">@opt</option>
                                            }
                                        </select>
                                        <button class="btn" @onclick="() => UpdateStatus(b)">Update</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <div class="form-card">
                <h3>Add booking</h3>
                <label>Type
                    <select @bind="newBooking.Type">
                        @foreach (var t in Enum.GetValues<BookingType>())
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                </label>
                <label>Provider
                    <input @bind="newBooking.Provider" placeholder="e.g. IndiGo, Taj Hotels" />
                </label>
                <label>Reference number
                    <input @bind="newBooking.BookingReference" placeholder="Booking / PNR reference" />
                </label>
                <label>Actual cost
                    <input type="number" step="0.01" min="0" @bind="newBooking.ActualCost" />
                </label>
                <label>Status
                    <select @bind="newBooking.Status">
                        @foreach (var s in Enum.GetValues<BookingStatus>())
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </label>
                <button class="btn btn-primary" @onclick="CreateBooking">Create booking</button>
            </div>
        }
    </section>
}

@code {
    [Parameter] public int Id { get; set; }

    private bool loaded;
    private string message = "";
    private TravelRequestDto? request;
    private List<BookingDto> existingBookings = [];
    private BookingCreateInput newBooking = new();
    private readonly Dictionary<int, BookingStatus> pendingStatus = new();

    protected override async Task OnInitializedAsync()
    {
        if (!await Auth.EnsureLoadedAsync()) return;
        await Load();
    }

    private async Task Load()
    {
        message = "";
        try
        {
            request = await Api.AdminRequestHistoryAsync(Id);
            var bookings = await Api.GetBookingsAsync(Id);
            existingBookings = bookings.ToList();
            pendingStatus.Clear();
            foreach (var b in existingBookings)
            {
                var options = NextStatusOptions(b.Status);
                if (options.Count > 0) pendingStatus[b.Id] = options[0];
            }
        }
        catch (Exception ex)
        {
            request = null;
            message = ApiErrors.Describe(ex);
        }
        finally { loaded = true; }
    }

    private async Task CreateBooking()
    {
        message = "";
        try
        {
            await Api.AddBookingAsync(Id, newBooking);
            newBooking = new BookingCreateInput();
            await Load();
            message = "Booking created.";
        }
        catch (Exception ex) { message = ApiErrors.Describe(ex); }
    }

    private async Task UpdateStatus(BookingDto b)
    {
        message = "";
        if (!pendingStatus.TryGetValue(b.Id, out var next)) return;
        try
        {
            await Api.UpdateBookingStatusAsync(Id, b.Id, next);
            await Load();
            message = "Booking status updated.";
        }
        catch (Exception ex) { message = ApiErrors.Describe(ex); }
    }

    // Status can only ever move forward along Pending -> Confirmed -> Cancelled;
    // once Cancelled, a booking is final and cannot be reopened or reversed.
    private static readonly BookingStatus[] Order = [BookingStatus.Pending, BookingStatus.Confirmed, BookingStatus.Cancelled];

    private static List<BookingStatus> NextStatusOptions(BookingStatus current)
    {
        var currentRank = Array.IndexOf(Order, current);
        return Order.Where((_, i) => i > currentRank).ToList();
    }

    private static string BookingStatusClass(BookingStatus status) => status switch
    {
        BookingStatus.Confirmed => "status-approved",
        BookingStatus.Cancelled => "status-cancelled",
        _ => "status-pendingmanager"
    };

    private void GoBack() => Nav.NavigateTo("/admin/approved-travel");
}
