@page "/profile/change-password"
@layout TravelRequestManagement.Client.Layout.TravelLayout
@rendermode InteractiveAuto
@attribute [Authorize]
@inject NavigationManager Nav

<PageTitle>Change Password - TravelDesk</PageTitle>

<div class="profile-page"><h1>Change password</h1><section class="password-card">
    <div class="security-banner">For your security, choose a password with at least 8 characters.</div>
    @if (Error is not null) { <p class="error">@Error</p> }
    <form method="post" action="/auth/change-password" class="password-form" data-enhance="false">
        <label>Current password<input required type="password" name="currentPassword" autocomplete="current-password" /></label>
        <div class="form-grid"><label>New password<input required type="password" name="newPassword" minlength="8" autocomplete="new-password" /></label><label>Confirm new password<input required type="password" name="confirmNewPassword" minlength="8" autocomplete="new-password" /></label></div>
        <div class="tabs"><button class="btn" type="submit">Update password</button><a class="btn btn-secondary" href="/profile">Cancel</a></div>
    </form>
</section></div>

@code {
    private string? Error
    {
        get
        {
            var item = new Uri(Nav.Uri).Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries)
                .FirstOrDefault(x => x.StartsWith("error=", StringComparison.OrdinalIgnoreCase));
            return item is null ? null : Uri.UnescapeDataString(item[6..].Replace("+", " "));
        }
    }
}
